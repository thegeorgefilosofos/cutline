# CUTLINE server configuration. Copy to .env and fill in locally.
# .env is git-ignored. Never commit real keys. Never prefix these with VITE_.

# Nous Research API key (server-side only)
NOUS_API_KEY=your-nous-api-key-here

# Optional: the exact model ID to use. Leave empty to auto-select a Hermes model
# from the authenticated /v1/models list. Check GET /api/status for available IDs.
NOUS_MODEL=

# Optional
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
PORT=8787

# ——— Hermes Agent (local CLI, logged in with `hermes portal`) ———
# Set INTERPRETER=hermes-agent to interpret memories with Hermes Agent instead of the Nous API.
INTERPRETER=
# Model for Hermes Agent, e.g. Hermes-4-405B (only if `hermes -z ... -m <model>` works for you)
HERMES_AGENT_MODEL=
# Usually: nous
HERMES_AGENT_PROVIDER=
# Toolsets the agent may use. Keep "todo" (an in-session task list only: no files, terminal,
# web or browser). Visitor text must never drive tools. ("none" is not a valid Hermes toolset.)
HERMES_AGENT_TOOLSETS=todo
# Optional: full path to hermes.exe if not in %LOCALAPPDATA%\hermes\bin\hermes.exe
HERMES_BIN=
HERMES_AGENT_TIMEOUT_MS=90000
