# CUTLINE server configuration. Copy to .env and fill in locally.
# .env is git-ignored. Never commit real keys. Never prefix these with VITE_.

# Nous Research API key (server-side only)
NOUS_API_KEY=your-nous-api-key-here

# Optional: the exact model ID to use. Leave empty to auto-select a Hermes model
# from the authenticated /v1/models list. Check GET /api/status for available IDs.
NOUS_MODEL=

# Optional
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
PORT=8787
